<Project>
  <Import Project="$([MSBuild]::GetPathOfFileAbove('Directory.Build.props', '$(MSBuildThisFileDirectory)../'))" />

  <!-- Test-project relaxations. CA1707: underscore test names are the xunit
       naming idiom and read as specifications. CA1861: inline literal arrays
       in request payloads read as the JSON they produce. -->
  <PropertyGroup>
    <NoWarn>$(NoWarn);CA1707;CA1861</NoWarn>
  </PropertyGroup>
</Project>
