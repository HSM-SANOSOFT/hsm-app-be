COOKIE_DOMAIN=''
COOKIE_SECURE=''
DB_ORACLE_DB='CHANGEME'
DB_ORACLE_HOST='CHANGEME'
DB_ORACLE_PASSWORD='CHANGEME'
DB_ORACLE_PORT='1521'
DB_ORACLE_USER='CHANGEME'
DB_POSTGRES_DB='hsm'
DB_POSTGRES_HOST='postgres'
DB_POSTGRES_PASSWORD='postgres'
DB_POSTGRES_PORT='5432'
DB_POSTGRES_USER='postgres'
DB_REDIS_HOST='redis'
DB_REDIS_PASSWORD='redis'
DB_REDIS_PORT='6379'
DB_REDIS_USER='redis'
DEFAULT_ADMIN_PASSWORD='CHANGEME'
DEFAULT_ADMIN_USERNAME='admin'
ENVIRONMENT='dev'
JWT_AT_SECRET='CHANGEME'
JWT_RT_SECRET='CHANGEME'
SMTP_ADDRESS='CHANGEME'
SMTP_PASSWORD='CHANGEME'
SMTP_PORT='587'
SMTP_SECURE='false'
SMTP_USERNAME='CHANGEME'
SMTP_WEBHOOK_KEY=''
STRG_S3_ACCESS_KEY='rustfs_user'
STRG_S3_FORCE_PATH_STYLE='true'
STRG_S3_HOST='http://rustfs:9000'
STRG_S3_HOST_EXTERNAL='CHANGEME'
