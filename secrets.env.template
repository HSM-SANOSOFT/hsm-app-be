# --- ASP.NET Core configuration keys (compose app services) ---------------
# "Production-shaped" here means the deployment shape (published container
# image, not `dotnet run`), not a distinct hardened environment — this system
# has one tier (Auth__Environment below is "dev", matching ENVIRONMENT above).
# UNQUOTED: Docker Compose's `env_file:` does not strip quote characters
# (unlike the npm dotenv package) — a quoted value here would inject literal
# quote marks into e.g. the Postgres connection string.
ASPNETCORE_ENVIRONMENT=Production

Otlp__Endpoint=http://otel-collector:4318

ConnectionStrings__HsmDb=Host=postgres;Port=5432;Username=postgres;Password=postgres;Database=hsm

Redis__ConnectionString=redis:6379,user=redis,password=redis

Storage__S3__Endpoint=http://rustfs:9000
Storage__S3__AccessKey=rustfs_user
Storage__S3__SecretKey=rustfs_password
Storage__S3__ForcePathStyle=true
Storage__S3__Bucket=hsm

Search__Meilisearch__Url=http://meilisearch:7700
Search__Meilisearch__ApiKey=meili_dev_master_key_please_rotate
Search__Collections__proving-notes=meilisearch

# Shared by hsm-app-api AND hsm-app-web — see the CF20 note above.
Auth__Environment=dev
Auth__JwtAccessSecret=CHANGEME
Auth__JwtRefreshSecret=CHANGEME
Auth__CsrfSecret=CHANGEME
Auth__CookieSecure=false
Auth__CookieDomain=
