<Project Sdk="Microsoft.NET.Sdk.Web">

  <ItemGroup>
    <ProjectReference Include="..\Hsm.Application\Hsm.Application.csproj" />
    <ProjectReference Include="..\Hsm.Infrastructure\Hsm.Infrastructure.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- The rest of the OpenTelemetry stack is a transitive dependency of
         Hsm.Infrastructure, which owns AddHsmTelemetry — see Hsm.Api.csproj's
         comment and TelemetryRegistration's doc comment for why ASP.NET Core
         instrumentation alone stays a direct reference here. -->
    <PackageReference Include="OpenTelemetry.Instrumentation.AspNetCore" />
    <!-- Screens (plan U18) render with MudBlazor; they now live in this host
         assembly (Option B, plan U8 amendment) instead of a separate RCL. -->
    <PackageReference Include="MudBlazor" />
  </ItemGroup>

  <PropertyGroup>
    <BlazorDisableThrowNavigationException>true</BlazorDisableThrowNavigationException>
  </PropertyGroup>

</Project>
