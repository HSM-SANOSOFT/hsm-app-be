@page "/documentos"
@attribute [Authorize(Roles = UiRoles.Admin)]
@using Hsm.Contracts
@inject IDocumentsAdminUiService Docs
@inject ISnackbar Snackbar
@inject IJSRuntime JS

@* Document management (plan U18, screen 5): list, upload, retrieve through a
   presigned URL, delete — createdBy scoping means the listing shows the
   signed-in admin's documents. *@

<PageTitle>Documentos — HSM</PageTitle>

<MudText Typo="Typo.h4" Class="mb-4">Documentos</MudText>

<MudPaper Class="pa-4 mb-4" Elevation="2" data-testid="upload-form">
    <MudText Typo="Typo.h6" Class="mb-3">Subir documento</MudText>
    <div class="d-flex align-center gap-3">
        @* Plain InputFile on purpose: it renders a real <input type="file">
           that works identically in the browser and under bUnit. *@
        <InputFile id="file-input" class="hsm-file-input" OnChange="OnFileSelected"
                   data-testid="file-input" />
        @if (_selectedFile is not null)
        {
            <MudText Typo="Typo.body2" data-testid="selected-file">@_selectedFile.Name</MudText>
        }
        <MudButton Color="Color.Primary"
                   Variant="Variant.Filled"
                   Disabled="@(_selectedFile is null || _uploading)"
                   OnClick="UploadAsync"
                   data-testid="upload-submit">
            Subir
        </MudButton>
    </div>
</MudPaper>

@if (_page is null)
{
    <MudProgressLinear Indeterminate="true" data-testid="documents-loading" />
}
else if (_page.Items.Count == 0)
{
    <MudText Typo="Typo.body2" Class="mud-text-secondary" data-testid="documents-empty">
        No hay documentos.
    </MudText>
}
else
{
    <MudTable T="DocumentRowDto" Items="_page.Items" Hover="true" Dense="true"
              data-testid="documents-table">
        <HeaderContent>
            <MudTh>Título</MudTh>
            <MudTh>Tipo</MudTh>
            <MudTh>Estado</MudTh>
            <MudTh>Creado</MudTh>
            <MudTh></MudTh>
        </HeaderContent>
        <RowTemplate>
            <MudTd DataLabel="Título">@context.Title</MudTd>
            <MudTd DataLabel="Tipo">@context.Type</MudTd>
            <MudTd DataLabel="Estado">@context.Status</MudTd>
            <MudTd DataLabel="Creado">@context.CreatedAt.ToString("yyyy-MM-dd HH:mm")</MudTd>
            <MudTd>
                <MudButton Size="Size.Small" Color="Color.Secondary" Variant="Variant.Outlined"
                           OnClick="@(() => OpenAsync(context))"
                           data-testid="@($"open-document-{context.Id}")">
                    Descargar
                </MudButton>
                <MudButton Size="Size.Small" Color="Color.Error" Variant="Variant.Outlined"
                           OnClick="@(() => DeleteAsync(context))"
                           data-testid="@($"delete-document-{context.Id}")">
                    Eliminar
                </MudButton>
            </MudTd>
        </RowTemplate>
    </MudTable>
    <div class="d-flex justify-center mt-4">
        <MudPagination Count="TotalPages" Selected="_pageNumber" SelectedChanged="ChangePageAsync" />
    </div>
}

@code {
    private const int PageSize = 10;
    private const long MaxUploadBytes = 50 * 1024 * 1024;

    private PagedResult<DocumentRowDto>? _page;
    private IBrowserFile? _selectedFile;
    private bool _uploading;
    private int _pageNumber = 1;

    private int TotalPages => _page is null || _page.TotalPages == 0 ? 1 : _page.TotalPages;

    protected override async Task OnInitializedAsync() => await LoadAsync();

    private async Task LoadAsync() => _page = await Docs.ListDocumentsAsync(_pageNumber, PageSize);

    private async Task ChangePageAsync(int page)
    {
        _pageNumber = page;
        await LoadAsync();
    }

    private void OnFileSelected(InputFileChangeEventArgs args) => _selectedFile = args.File;

    private async Task UploadAsync()
    {
        if (_selectedFile is null)
        {
            return;
        }

        _uploading = true;
        try
        {
            await using var content = _selectedFile.OpenReadStream(MaxUploadBytes);
            await Docs.UploadAsync(
            [
                new UploadFileDto(
                    _selectedFile.Name,
                    string.IsNullOrEmpty(_selectedFile.ContentType)
                        ? "application/octet-stream"
                        : _selectedFile.ContentType,
                    _selectedFile.Size,
                    content),
            ]);
            Snackbar.Add($"Documento '{_selectedFile.Name}' subido.", Severity.Success);
            _selectedFile = null;
            await LoadAsync();
        }
        catch (Exception ex)
        {
            Snackbar.Add($"No se pudo subir el documento: {ex.Message}", Severity.Error);
        }
        finally
        {
            _uploading = false;
        }
    }

    private async Task OpenAsync(DocumentRowDto document)
    {
        try
        {
            var url = await Docs.GetDownloadUrlAsync(document.Id);
            await JS.InvokeVoidAsync("open", url, "_blank");
        }
        catch (Exception ex)
        {
            Snackbar.Add($"No se pudo obtener el documento: {ex.Message}", Severity.Error);
        }
    }

    private async Task DeleteAsync(DocumentRowDto document)
    {
        try
        {
            await Docs.DeleteAsync(document.Id);
            Snackbar.Add($"Documento '{document.Title}' eliminado.", Severity.Success);
            await LoadAsync();
        }
        catch (Exception ex)
        {
            Snackbar.Add($"No se pudo eliminar el documento: {ex.Message}", Severity.Error);
        }
    }
}
