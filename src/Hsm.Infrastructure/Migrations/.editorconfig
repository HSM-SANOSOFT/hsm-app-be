# Scaffolded EF Core migrations. `dotnet dotnet-ef migrations add` writes these
# files and nothing else may: a hand-edit here is a migration that no longer
# equals the model, which `migrations has-pending-model-changes` cannot catch
# and the first real database created from it discovers.
#
# The generator emits inline literal arrays (`columns: new[] { ... }`,
# `values: new object[,] { ... }`), which CA1861 asks callers to hoist into
# static readonly fields. That advice is right for hand-written code and
# impossible here, so the rule is turned off FOR THIS DIRECTORY ONLY — not
# project-wide, and not with a pragma inside a generated file.
[*.cs]
dotnet_diagnostic.CA1861.severity = none
