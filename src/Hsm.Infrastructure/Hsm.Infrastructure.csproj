<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\Hsm.Application\Hsm.Application.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- ASP.NET Core Identity's DataProtectorTokenProvider — the thing that
         makes a password-reset token a signed, expiring, single-use blob
         instead of a row — ships ONLY in the Microsoft.AspNetCore.App shared
         framework; Microsoft.Extensions.Identity.Core carries the six-digit
         TOTP providers and nothing else. Rather than hand-roll a token format,
         the composition root takes the framework reference. Task 12 needs it
         anyway (cookie + JwtBearer schemes register here), and Hsm.Worker's
         runtime image moves to dotnet/aspnet with it. -->
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="AWSSDK.S3" />
    <PackageReference Include="Handlebars.Net" />
    <!-- The bearer half of the adaptive scheme (AddHsmIdentityAuthentication).
         It sits HERE rather than in the two hosts because the scheme
         registration does — one configuration, both doors — and it flows to
         Hsm.Api/Hsm.Web transitively. It is a NuGet package, not part of the
         Microsoft.AspNetCore.App shared framework referenced above. -->
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" />
    <!-- The EF Core Identity stores HsmDbContext (an IdentityDbContext) backs. -->
    <PackageReference Include="Microsoft.AspNetCore.Identity.EntityFrameworkCore" />
    <PackageReference Include="MeiliSearch" />
    <PackageReference Include="Microsoft.Extensions.Caching.StackExchangeRedis" />
    <!-- Microsoft.Extensions.{Hosting.Abstractions,Configuration.Binder} are
         gone: the shared framework above already carries them, and NuGet
         refuses (NU1510) to keep a package reference it will prune. -->
    <!-- Design-time only (migrations scaffolding); never flows to consumers
         or ships in the published output. -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.IdentityModel.JsonWebTokens" />
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" />
    <PackageReference Include="QuestPDF" />
    <PackageReference Include="StackExchange.Redis" />
    <!-- Telemetry (Task 23): the shared AddHsmTelemetry registration lives
         here, so its packages do too. OpenTelemetry.Instrumentation.AspNetCore
         is deliberately NOT here — see TelemetryRegistration's doc comment;
         it stays a direct reference of Hsm.Api/Hsm.Web only. `console` uses
         the official exporter package below; `file` has no official package
         to use (none exists) and stays a small hand-rolled BaseExporter
         (FileLineExporter, in TelemetryRegistration.cs). -->
    <PackageReference Include="Npgsql.OpenTelemetry" />
    <PackageReference Include="OpenTelemetry.Exporter.Console" />
    <PackageReference Include="OpenTelemetry.Exporter.OpenTelemetryProtocol" />
    <PackageReference Include="OpenTelemetry.Extensions.Hosting" />
    <PackageReference Include="OpenTelemetry.Instrumentation.Http" />
    <PackageReference Include="OpenTelemetry.Instrumentation.Runtime" />
  </ItemGroup>

  <PropertyGroup>
  </PropertyGroup>

</Project>
